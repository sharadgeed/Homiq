# ===================================================
# HOMIQ - India-Focused Rental Accommodation Platform
# Environment Configuration Template
# ===================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production
SESSION_COOKIE_NAME=homiq_session

# Database
# Default uses local self-contained SQLite relational database
DATABASE_PATH=./data/homiq.db

# Storage / Media Uploads (Local development storage)
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_MB=5

# External Integrations (Optional in Development, gracefully mocked)
# Map Provider (OpenStreetMap is used by default with zero key requirement)
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# SMS / OTP Verification Gateway (e.g. MSG91, Twilio)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# Identity / Aadhaar / PAN Verification API (Sandbox / Production Provider)
ID_VERIFY_PROVIDER_API_KEY=
ID_VERIFY_WEBHOOK_SECRET=
